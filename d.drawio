                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Основные бизнес-классы\n    class SalesForecastApp {\n        -DataManager data_manager\n        -SimpleNeuralNetworkEngine forecast_engine\n        -pd.DataFrame raw_data\n        -pd.DataFrame processed_data\n        -list forecast_results\n        -list model_accuracy\n        +load_csv_file()\n        +run_forecast()\n        +update_data_table()\n        +update_forecast_chart()\n        +generate_sales_report()\n        +clear_data()\n    }\n\n    class DataManager {\n        -AdvancedFeatureEngineer feature_engineer\n        -DataValidationRules validation_rules\n        -AppConfig config\n        +load_data_from_csv(file_path)\n        +preprocess_data(df)\n        +get_data_statistics(df)\n        -validate_raw_data(df)\n        -validate_processed_data(df)\n    }\n\n    class AdvancedFeatureEngineer {\n        -string country\n        -list holidays\n        +create_advanced_features(df)\n        -create_basic_features(df)\n        -create_temporal_features(df)\n        -create_seasonal_features(df)\n        -create_calendar_features(df)\n        -create_statistical_features(df)\n        -load_holidays()\n    }\n\n    class SimpleNeuralNetworkEngine {\n        -any model\n        -string model_type\n        -string current_file_path\n        -dict model_metrics\n        +train_model(session_data, optimize_hyperparams)\n        +make_predictions(model, session_data, days_to_forecast)\n        +get_model_metrics(session_data)\n        +set_current_file_path(file_path)\n    }\n\n    %% Конфигурационные классы\n    class AppConfig {\n        +string DATETIME_FORMAT\n        +string DISPLAY_DATE_FORMAT\n        +int MIN_DATA_POINTS\n        +int FORECAST_DAYS\n        +dict MODEL_PARAMS\n        +dict TIME_SERIES_CV\n        +dict COLORS\n        +dict FONTS\n    }\n\n    class DataValidationRules {\n        +list REQUIRED_COLUMNS\n        +dict DATE_RANGE\n        +dict VALUE_RANGES\n    }\n\n    class ModernTheme {\n        +dict COLORS\n        +dict FONTS\n        +setup_styles()\n    }\n\n    %% Классы отчетности\n    class ReportGenerator {\n        +generate_sales_report(session_data)\n        +generate_forecast_report(session_data)\n        +generate_full_report(session_data)\n        -calculate_sales_statistics(df)\n        -calculate_forecast_statistics(forecast_results)\n        -create_sales_plot(df, stats)\n        -create_forecast_plot(historical_data, forecast_results, model_info)\n        -html_to_pdf(html_content)\n    }\n\n    %% Внешние библиотеки\n    class HTML {\n        +write_pdf(buffer)\n    }\n\n    class Template {\n        +render(**kwargs)\n    }\n\n    class RotatingFileHandler {\n        +setFormatter(formatter)\n        +setLevel(level)\n    }\n\n    class FigureCanvasTkAgg {\n        +draw()\n        +get_tk_widget()\n    }\n\n    class GridSearchCV {\n        +fit(X, y)\n        +best_estimator_\n        +best_params_\n    }\n\n    class Ridge {\n        +fit(X, y)\n        +predict(X)\n    }\n\n    class StandardScaler {\n        +fit_transform(X)\n        +transform(X)\n    }\n\n    class TimeSeriesSplit {\n        +split(X)\n    }\n\n    class DataFrame {\n        +columns\n        +shape\n        +head()\n        +tail()\n        +groupby()\n        +sort_values()\n        +dropna()\n    }\n\n    class Tk {\n        +title()\n        +geometry()\n        +mainloop()\n    }\n\n    class Notebook {\n        +add()\n        +pack()\n    }\n\n    class Treeview {\n        +insert()\n        +delete()\n        +heading()\n        +column()\n    }\n\n    %% СВЯЗИ МЕЖДУ КЛАССАМИ\n    SalesForecastApp --&gt; DataManager : использует\n    SalesForecastApp --&gt; SimpleNeuralNetworkEngine : использует\n    SalesForecastApp --&gt; ModernTheme : использует\n    SalesForecastApp --|&gt; Tk : наследует\n    SalesForecastApp *--&gt; Notebook : содержит\n    SalesForecastApp *--&gt; Treeview : содержит\n    SalesForecastApp *--&gt; FigureCanvasTkAgg : содержит\n    SalesForecastApp --&gt; DataFrame : хранит данные\n    SalesForecastApp ..&gt; ReportGenerator : вызывает\n    \n    DataManager --&gt; AdvancedFeatureEngineer : использует\n    DataManager --&gt; DataValidationRules : использует\n    DataManager --&gt; AppConfig : использует\n    DataManager --&gt; DataFrame : обрабатывает\n    DataManager ..&gt; RotatingFileHandler : логирует\n    \n    AdvancedFeatureEngineer --&gt; DataFrame : преобразует\n    AdvancedFeatureEngineer --&gt; AppConfig : использует настройки\n    \n    SimpleNeuralNetworkEngine --&gt; AppConfig : использует параметры\n    SimpleNeuralNetworkEngine *--&gt; GridSearchCV : создает\n    SimpleNeuralNetworkEngine *--&gt; Ridge : обучает\n    SimpleNeuralNetworkEngine --&gt; StandardScaler : использует\n    SimpleNeuralNetworkEngine --&gt; TimeSeriesSplit : использует\n    SimpleNeuralNetworkEngine --&gt; DataFrame : анализирует\n    SimpleNeuralNetworkEngine ..&gt; RotatingFileHandler : логирует\n    \n    ReportGenerator ..&gt; HTML : генерирует PDF\n    ReportGenerator ..&gt; Template : рендерит шаблоны\n    ReportGenerator --&gt; DataFrame : анализирует данные\n    ReportGenerator &lt;.. SalesForecastApp : получает данные\n    \n    ModernTheme --&gt; AppConfig : использует цвета\n    ModernTheme ..&gt; Tk : настраивает стиль\n    \n    %% Связи между внешними классами\n    GridSearchCV *--&gt; Ridge : оптимизирует\n    GridSearchCV *--&gt; StandardScaler : использует в pipeline\n    GridSearchCV --&gt; TimeSeriesSplit : использует для CV\n    \n    FigureCanvasTkAgg ..&gt; Tk : встраивает в GUI\n    Notebook --|&gt; Tk : является частью GUI\n    Treeview --|&gt; Tk : является частью GUI\n    \n    RotatingFileHandler &lt;.. SalesForecastApp : логирует события\n    RotatingFileHandler &lt;.. DataManager : логирует операции\n    RotatingFileHandler &lt;.. SimpleNeuralNetworkEngine : логирует ML&quot;&#xa;}" id="385">
